{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}",
    "--header-insertion=never",
    "--query-driver=${workspaceFolder}/.zephyr-sdk/riscv64-zephyr-elf/bin/riscv64-zephyr-elf-*,${workspaceFolder}/.zephyr-sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-*"
  ],
  "clangd.checkUpdates": false,
  "files.associations": {
    "*.h": "c"
  }
}
