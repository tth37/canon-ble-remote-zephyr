{
  "configurations": [
    {
      "name": "ESP32-C6 firmware",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "compilerPath": "${workspaceFolder}/.platformio/packages/toolchain-riscv32-esp/bin/riscv32-esp-elf-gcc",
      "includePath": [
        "${workspaceFolder}/firmware/esp32c6/src/**",
        "${workspaceFolder}/shared/canon/include/**",
        "${workspaceFolder}/.platformio/packages/framework-espidf/components/**"
      ],
      "defines": [
        "ESP_PLATFORM",
        "IDF_VER=\"v6.0.1\""
      ],
      "cStandard": "c17"
    }
  ],
  "version": 4
}
