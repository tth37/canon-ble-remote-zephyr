{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: Build selected target",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Firmware: Select ESP32-C6",
      "type": "shell",
      "command": "make select TARGET=esp32c6",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Select Pro Micro nRF52840",
      "type": "shell",
      "command": "make select TARGET=nrf52840",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Upload selected target",
      "type": "shell",
      "command": "make upload",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Run shared tests",
      "type": "shell",
      "command": "make test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Firmware: Refresh compile commands",
      "type": "shell",
      "command": "make compile-commands",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Serial terminal",
      "type": "shell",
      "command": "make serial",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
