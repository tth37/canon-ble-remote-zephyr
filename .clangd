CompileFlags:
  # PlatformIO emits a GCC compilation database. Apple clangd understands the
  # target and include paths, but these ESP GCC-only driver flags are invalid.
  Remove:
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
